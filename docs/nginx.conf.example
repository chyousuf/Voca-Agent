# Install behind your HTTPS reverse proxy. Set VOCA_BASE_URL to this HTTPS origin.
# Adapt certificate paths and server_name for your deployment.
server {
    listen 443 ssl;
    server_name agent.example.com;
    ssl_certificate /etc/letsencrypt/live/agent.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent.example.com/privkey.pem;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 75s;
        proxy_connect_timeout 5s;
        # Set VOCA_TRUST_LOCAL_PROXY=1 when nginx reaches the agent from loopback.
        # Keep the upstream bound to loopback; overwrite X-Real-IP as above.
    }
}

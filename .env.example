# Run python setup.py to generate installation-specific secrets.
VOCA_ADMIN_TOKEN=GENERATE_ADMIN_TOKEN
VOCA_ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY
VOCA_BASE_URL=http://127.0.0.1:8787
VOCA_BIND=127.0.0.1
VOCA_TRUST_LOCAL_PROXY=0
# Development only: allow a named local WordPress site to send content.
# This does not enable private-network crawling.
VOCA_LOCAL_DEV_HOSTS=
PORT=8787
# Required for actual AI answers. Keep this key on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
VOCA_MAX_PAGES=300
VOCA_REFRESH_SECONDS=21600

# Minimum cosine similarity for a retrieved section to be sent to the answer model. Tune against your own evaluation set.
VOCA_MIN_RELEVANCE_SCORE=0.18
